# libsodchan wire golden vectors — suite V1 (ADR 017)
# Format: NAME on its own line, then whitespace-separated hex bytes.
# Layout-only: id_sig patterns are not cryptographic signatures.
#
# Key material patterns used throughout:
#   client_eph_pk = 00..1f
#   server_eph_pk = 20..3f
#   server_id_pk  = 40..5f
#   client_id_pk  = 60..7f
#   client HELLO id_sig = 64 zero bytes
#   server HELLO id_sig = (i*3)&0xff for i in 0..63  (layout only)
#   client_sig for AUTH = 0xa0+(i%16) for i in 0..63 (layout only)
#   username = "alice", device_id = "dev-1"

